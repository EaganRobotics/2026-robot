#!/bin/bash
# Navigate to repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

FRC_YEAR="2026"

# --- 1. DEFINE THE KNOWN WINDOWS PATH ---
# Git Bash usually accesses C:\ via /c/
RAW_WIN_PATH="/c/Users/Public/wpilib/$FRC_YEAR/jdk"

# --- 2. CHECK IF WE ARE ON WINDOWS ---
# We check if that folder exists. 
if [ -d "$RAW_WIN_PATH" ]; then
    echo "✅ Detected Windows WPILib install at $RAW_WIN_PATH"
    
    # CRITICAL FIX: Convert the path to Windows format (C:\Users\...)
    # Gradle (Windows CMD) cannot read "/c/Users/...", it needs "C:\Users\..."
    if command -v cygpath &> /dev/null; then
        export JAVA_HOME=$(cygpath -w "$RAW_WIN_PATH")
    else
        # Fallback if cygpath is missing (rare in Git Bash)
        export JAVA_HOME="C:\\Users\\Public\\wpilib\\$FRC_YEAR\\jdk"
    fi
    
    export PATH="$JAVA_HOME/bin:$PATH"
    GRADLE_EXEC="./gradlew.bat"

else
    # --- 3. FALLBACK FOR MAC/LINUX ---
    # If the Windows path doesn't exist, we assume standard Unix paths
    echo "🔎 Windows WPILib not found, checking standard Unix paths..."
    
    FRC_HOME="$HOME/wpilib/$FRC_YEAR"
    if [ -d "$FRC_HOME/jdk" ]; then
        export JAVA_HOME="$FRC_HOME/jdk"
        export PATH="$JAVA_HOME/bin:$PATH"
    fi
    GRADLE_EXEC="./gradlew"
fi

# Debug Output to verify
echo "Using JAVA_HOME: $JAVA_HOME"
echo "Using Gradle Wrapper: $GRADLE_EXEC"

# --- 4. RUN SPOTLESS ---
echo "🚀 Running Spotless..."

if ! $GRADLE_EXEC spotlessApply --quiet --no-daemon -x test; then
    echo "⚠️  Spotless hit a cache conflict. Attempting self-repair..."
    rm -rf .gradle/spotless
    
    if ! $GRADLE_EXEC spotlessApply --quiet --no-daemon -x test; then
        echo "❌ Spotless failed! Check build.gradle or JAVA_HOME."
        exit 1
    fi
fi

# Re-stage modified files
git add .
